/* ── Rofi Theme ──────────────────────────────
   °˖* ૮(  • ᴗ ｡)っ🍸  Dionysus Theme
   Auto-generated by matugen - DO NOT EDIT
   ─────────────────────────────────────────── */

/* Global defaults */
* {
  font: "JetBrainsMono Nerd Font 11";
  blur: true;
  padding: 10px;
  background-color: transparent;
  border-radius: 0px;
}

/* ── Window ──────────────────────────────── */
window {
  width: 750px;
  height: 625px;
  location: center;
  blur: true;
  border: 2px;
  border-radius: 3px;
  border-color: #a9c7ff;
  background-color: transparent;
  padding: 0px;
  margin: 30px 50px;
}

/* ── Layout ──────────────────────────────── */
mainbox {
  orientation: horizontal;
  children: [ "borderbox" ];
  spacing: 0px;
  padding: 0px;
}

borderbox {
  orientation: horizontal;
  children: [ "imagebox", "contentbox" ];
  padding: 0px;
  spacing: 0px;
  border-radius: 3px;
}

contentbox {
  orientation: vertical;
  children: [ "entry", "listview" ];
  spacing: 0px;
  padding: 0px;
  expand: true;
}

/* ── Imagebox (uses symlink to current wallpaper) ───────────── */
imagebox {
  background-image: url("~/.config/rofi/current-wallpaper");
  background-repeat: false;
  size: 300px 625px;
}

/* ── Elements ────────────────────────────── */
element {
  border-radius: 0px;
}

element-text, element-icon {
  padding: 6px 8px;
  spacing: 2px;
  text-color: #dcbce1;
}

element selected {
  background-color: #1d2024;
  text-color: #e2e2e9;
  border-radius: 3px;
}

/* ── Input & Prompt ──────────────────────── */
prompt {
  enabled: false;
  background-color: transparent;
  text-color: #a9c7ff;
  padding: 5px 10px;
}

entry {
  padding: 8px;
  expand: false;
  font: "JetBrainsMono Nerd Font 12";
  text-color: #dcbce1;
  border-radius: 0px 3px 0px 0px;
  background-color: #111318;
}

/* ── Listview ────────────────────────────── */
listview {
  lines: 1;
  background-color: #1d2024cc;
  border-radius: 0px 0px 3px 0px;
  padding: 5px;
}
