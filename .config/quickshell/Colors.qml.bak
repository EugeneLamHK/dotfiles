pragma Singleton
import Quickshell
import QtQuick

Singleton {
    id: root

    readonly property color foreground: "#e3e2e9"
    readonly property color foregroundInactive: "#c5c6d0"
    readonly property color textDim: "#c5c6d0"
    readonly property color accent: "#b2c5ff"
    readonly property color background: "#121318"
    readonly property color surface: "#121318"
    readonly property color barBackground: Qt.rgba(16/255, 16/255, 16/255, 0.5)

    readonly property color arch: "#b2c5ff"
    readonly property color archHoverBg: "#1e1f25"
    readonly property color vpn: "#c0c6dd"
    readonly property color vpnHoverBg: "#1e1f25"
    readonly property color workspaceActive: "#e3e2e9"
    readonly property color workspaceInactive: "#c5c6d0"
    readonly property color workspaceHover: "#b2c5ff"

    readonly property color battery: "#e1bbdc"
    readonly property color batteryHoverBg: "#1e1f25"
    readonly property color volume: "#e3e2e9"
    readonly property color volumeHoverBg: "#1e1f25"

    readonly property color brightness100: "#f1c40f"
    readonly property color brightness75: "#e67e22"
    readonly property color brightness50: "#e91e63"
    readonly property color brightness25: "#e74c3c"
    readonly property color brightnessError: "#95a5a6"
    readonly property color brightnessHoverBg: Qt.rgba(1, 1, 1, 0.1)
    readonly property color dayOfWeek: "#bb9af7"
    readonly property color dayOfWeekHoverBg: Qt.rgba(187/255, 154/255, 247/255, 0.1)

    readonly property string fontFamily: "JetBrainsMono Nerd Font"
    readonly property int fontSize: 15
    readonly property int fontSizeSmall: 13
    readonly property int fontSizeLarge: 17
    readonly property int fontSizeWorkspace: 18
}
